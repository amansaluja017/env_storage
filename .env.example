# ==========================================
# Tubo Monorepo Environment Variables Example
# Copy this file to .env or app-specific .env files
# ==========================================

# API Server Configuration
PORT=4000
JWT_SECRET=tubo_secret_key_2026_safe

# Database Configurations
# PostgreSQL Connection (for Auth, Workspaces & Teams)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/env_stroage

# SQLite Path (for Encrypted Env Storage Vault)
SQLITE_DB_PATH=./data/env_stroage.db

# Mobile App Configuration (Expo)
# For Android Emulator: http://10.0.2.2:4000 (or http://localhost:4000 if 'adb reverse tcp:4000 tcp:4000' is run)
# For iOS Simulator / Web: http://localhost:4000
# For physical devices: replace with your host machine's LAN IP (e.g., http://192.168.1.50:4000)
EXPO_PUBLIC_API_URL=http://localhost:4000
