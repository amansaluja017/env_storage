# API Server Port
PORT=4000

# Secret key for JWT session authentication
JWT_SECRET=tubo_secret_key_2026_safe
JWT_REFRESH_SECRET=tubo_refresh_secret_key_2026_safe
NODE_ENV=development

# PostgreSQL Connection String (Auth, Workspaces, Teams)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tubo_db

# SQLite Database Storage Path (Env Vault Storage)
SQLITE_DB_PATH=./data/tubo_envs.db

# Public URL for web verification & reset password links
# In production on Render: https://<your-service>.onrender.com (auto-detected if omitted)
APP_PUBLIC_URL=http://localhost:4000

# -------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION (Choose Option A or Option B)
# -------------------------------------------------------------

# Option A: Resend HTTP API (RECOMMENDED for Production & Render)
# Render Free Tier BLOCKS outbound SMTP ports (25, 465, 587).
# Resend communicates via HTTPS (port 443), working 100% on Render.
# Get free API key (3,000 free emails/month) at https://resend.com
# RESEND_API_KEY=re_1234567890
# EMAIL_FROM=Tubo Vault <onboarding@resend.dev>

# Option B: Gmail SMTP via Nodemailer
# NOTE: Only works locally or on paid VPS/cloud instances where SMTP ports are open.
# Will fail with ETIMEDOUT on Render free tier.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
