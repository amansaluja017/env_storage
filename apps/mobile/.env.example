# Base URL of the Tubo API backend server
# For Android Emulator: http://10.0.2.2:4000 (or http://localhost:4000 if 'adb reverse tcp:4000 tcp:4000' is configured)
# For local iOS simulator / web: http://localhost:4000
# For physical mobile device on LAN: replace with your development machine's LAN IP (e.g. http://192.168.1.50:4000)
EXPO_PUBLIC_API_URL=http://localhost:4000
