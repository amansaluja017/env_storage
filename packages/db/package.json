{
  "name": "@tubo/db",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate --config drizzle.config.cjs",
    "db:push": "drizzle-kit generate --config drizzle.config.cjs && drizzle-kit migrate --config drizzle.config.cjs",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.cjs",
    "db:studio": "drizzle-kit studio --config drizzle.config.cjs",
    "generate": "drizzle-kit generate --config drizzle.config.cjs",
    "push": "drizzle-kit generate --config drizzle.config.cjs && drizzle-kit migrate --config drizzle.config.cjs",
    "migrate": "drizzle-kit migrate --config drizzle.config.cjs",
    "studio": "drizzle-kit studio --config drizzle.config.cjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.3.3"
  }
}
